# -----------------------------------------------------------------------------
# SYNAPSE environment. Copy to .env.local (never commit real values).
# Variables prefixed NEXT_PUBLIC_ are sent to the browser; everything else
# stays on the server.
# -----------------------------------------------------------------------------

# Public URL of the app (used for email-confirmation links). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data source --------------------------------------------------------------
# "supabase" (accounts, saved progress, RLS) or "local" (read-only view of
# data/processed/ on this machine, no sign-in). Default: supabase when the
# Supabase variables below are set; otherwise local in development.
# Production never falls back to local mode unless you set it explicitly.
# NOTE: set this at build time too — the static shell is prerendered.
# SYNAPSE_DATA_SOURCE=local
# Where the ingestion pipeline writes its output (default: ./data)
# SYNAPSE_DATA_DIR=./data

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…); the legacy anon key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Direct Postgres connection for scripts/load_to_database.py ONLY (service
# access; bypasses RLS). Keep it out of the web app's environment.
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- AI generation (Claude) — server only ---------------------------------------
ANTHROPIC_API_KEY=
# Model ID is configurable; default claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (default medium)
ANTHROPIC_EFFORT=medium

# --- Embeddings (optional, provider-independent) -------------------------------
# Claude does not provide embeddings. Without a provider SYNAPSE uses
# PostgreSQL full-text search only. "voyage" enables hybrid retrieval
# (requires the pgvector migration; 1024 dimensions).
EMBEDDINGS_PROVIDER=none
# VOYAGE_API_KEY=
# VOYAGE_EMBEDDING_MODEL=voyage-3.5

# --- Ingestion pipeline (Python) ------------------------------------------------
# Path to the subject archive (default: auto-discover in source-material/ or
# the project root; a .zip extension is optional).
# SYNAPSE_ARCHIVE_PATH=source-material/subject-material.zip

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the committed env template
!.env.example

# ---------------------------------------------------------------
# SYNAPSE — private study material. NEVER commit any of this.
# ---------------------------------------------------------------
# Original archives (any location in the project root)
/source-material/
/*.zip
/Computer-fundamentals-and-networking-*
# Everything the ingestion pipeline produces (extracted files,
# processed JSON, reports) — keep only the placeholder README.
/data/*
!/data/README.md

# Python ingestion worker
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Playwright / Vitest artefacts
/playwright-report/
/test-results/
/blob-report/
/tests/e2e/.fixture-data/
